<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reuse the library package version without introducing a second version authority. -->
  <Import Project="../../src/Directory.Build.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The package hash changes when this branch is rebuilt; test each freshly produced package. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Must resolve from the freshly packed .nupkg, never from a project reference. -->
    <PackageReference Include="Dnstap.NET" Version="$(Version)" />
  </ItemGroup>
</Project>
